# UrbanHeat AI — Backend Environment Configuration Example

APP_NAME="UrbanHeat AI - Climate Intelligence Platform"
APP_VERSION="2.0.0"
DEBUG=True
SECRET_KEY="your-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./urban_heat.db"

# Google Maps Platform (Maps JS, Places New, Geocoding, Weather)
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=""
GOOGLE_WEATHER_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# Google Earth Engine Project Identifier
# https://earthengine.google.com/
GOOGLE_EARTH_ENGINE_PROJECT=""

# Real-Time Telemetry Providers
OPENWEATHER_API_KEY=""
TOMTOM_API_KEY=""
OPENAQ_API_KEY=""

# Grounded AI Assistant (Google Gemini 1.5 Flash)
GEMINI_API_KEY=""

# Default Initial Map Coordinates (Nerul, Navi Mumbai)
DEFAULT_LAT=19.0330
DEFAULT_LON=73.0297
DEFAULT_LOCATION_NAME="Nerul, Navi Mumbai"
